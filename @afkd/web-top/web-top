#!/usr/bin/env python3
"""@afkd/web-top — an afkd companion that relays the control wire to a browser.

The daemon starts this program, hands it the control socket it already bound and the
settings its `plugin @afkd/web-top { … }` block carried, and from there this is a **relay**
and very nearly nothing else: every subscriber gets its **own** attach to the daemon, every
frame that attach reads is forwarded verbatim as one SSE `data:` line, and the operator's
intents come back the other way as `command` frames on that same attach.

It folds nothing and keeps no model. That is the whole design: the daemon serves each
connection its own `meta.snapshot`, so a second browser is a second attach rather than a
second reader of one mid-stream. The dashboard is painted in the browser, by `fold.mjs` and
the modules beside it.

The **one** thing it does on its own account is the run **backfill**. The daemon serves its
history burst only to a TCP client — a local-socket client is expected to share the
filesystem and read the run dirs itself — and a companion is handed the local socket, so
without this the page's run view would be empty until something fired. So on each
subscriber's `meta.snapshot` this program reads the daemon's own run corpus off disk and
serves it as the very `backfill` / `backfill_log` frames the wire already carries for it,
ahead of that subscriber's first live frame (see *the run corpus* below).

Standard library only, so it installs on a host with no toolchain.
"""

import http.server
import json
import os
import socket
import stat
import sys
import threading
import unicodedata
import urllib.parse

# This plugin's own name, as the manifest spells it and every sentence it writes names it.
NAME = "@afkd/web-top"

# The plugin protocol the `hello` is compared on, and the control wire's own version. Two
# different integers in afkd; both are 1 today, and each is compared by equality.
PLUGIN_PROTO = 1
WIRE_PROTO = 1

# The most bytes either end buffers for one JSONL frame — the bound the daemon holds too.
MAX_LINE = 64 * 1024

# What an unwritten setting means. A block naming this companion with nothing in it must
# still come up, which is the first thing anybody tries. 8770 is the example companion's,
# so the two can be run side by side, and a `listen` that names a host alone keeps the
# port.
DEFAULT_HOST = "127.0.0.1"
DEFAULT_PORT = 8771
DEFAULT_MAX_CLIENTS = 8
# How many log lines the page's fold keeps per service. `LOG_RING_CAPACITY` in
# `crates/tui/src/logring.rs` — the terminal dashboard's own bound, so a browser and a
# terminal watching the same daemon scroll back the same distance.
DEFAULT_LOG_LINES = 2000

# How long an idle stream waits before it writes a comment, so a proxy in the middle never
# reads the quiet as a dead connection. It is also the attach's socket timeout: the reader
# wakes on it, writes the comment, and goes back to the same partial line.
KEEPALIVE_S = 15.0

# How long the shutdown waits for open streams to take their final event. A browser that
# stopped reading must not hold the drain, so this is a ceiling, not a join.
STREAM_DRAIN_S = 1.0

# The verbs `POST /command` composes a frame for, split by what each one carries
# (`crates/app/src/proto.rs`, `enum Command`). Nothing outside these reaches the socket.
SERVICE_VERBS = ("start", "stop", "restart", "fire", "force")
GLOBAL_VERBS = ("reload", "status", "doctor", "validate")
OPTIONAL_SERVICE_VERBS = ("runs",)
VOCABULARY = SERVICE_VERBS + GLOBAL_VERBS + OPTIONAL_SERVICE_VERBS

# What the listener serves out of its own directory, by extension. An allowlist rather than
# a denylist: this process runs unconfined with the daemon's privileges, so the set of
# things a browser can read out of it is written down rather than inferred.
STATIC_TYPES = {
    ".html": "text/html; charset=utf-8",
    ".mjs": "text/javascript; charset=utf-8",
    ".css": "text/css; charset=utf-8",
}

# The directory this program was installed into — the static root, and the only one.
HERE = os.path.dirname(os.path.abspath(__file__))


def die(sentence):
    """One sentence on stderr and exit 1 — never a traceback.

    The daemon's restart policy owns what happens next; this program does not
    second-guess it.
    """
    print(sentence, file=sys.stderr, flush=True)
    raise SystemExit(1)


# --- settings ----------------------------------------------------------------------


def setting_int(settings, key, default, low, high):
    """One setting as an integer in range, or a named fault.

    Every value arrives as a **string**: afkd lowers a scalar to a JSON string and a bare
    key with no value to `true`, and omits an unwritten key entirely. So the coercion and
    the default live in one place, and `max_clients` written as a word is a sentence
    rather than a traceback four frames later.
    """
    raw = settings.get(key, default)
    if isinstance(raw, bool) or not isinstance(raw, (str, int)):
        die("%s: setting `%s` must be an integer, not %r" % (NAME, key, raw))
    try:
        value = int(raw)
    except ValueError:
        die("%s: setting `%s` must be an integer, not %r" % (NAME, key, raw))
    if not low <= value <= high:
        die("%s: setting `%s` must be between %d and %d, not %d"
            % (NAME, key, low, high, value))
    return value


def setting_str(settings, key, default):
    """One setting as a non-empty string, or a named fault."""
    raw = settings.get(key, default)
    if isinstance(raw, bool) or not isinstance(raw, str) or not raw.strip():
        die("%s: setting `%s` must be a non-empty string, not %r" % (NAME, key, raw))
    return raw.strip()


def setting_listen(settings, key, default_host, default_port):
    """`listen "host[:port]"` as an IPv4 host and a port, or a named fault.

    afkd's own spelling for an address to bind: its `bind` block and the webhook trigger
    take the same shape, so an operator writes one word for one thing. A bare host keeps
    `default_port`, and a port of `0` binds an ephemeral one.
    """
    if key not in settings:
        return default_host, default_port
    text = setting_str(settings, key, "")
    host, sep, port = text.rpartition(":")
    if not sep:
        return text, default_port
    if not host:
        die("%s: setting `%s` must be \"host[:port]\", not %r" % (NAME, key, text))
    try:
        number = int(port)
    except ValueError:
        die("%s: setting `%s` must end in a port number, not %r" % (NAME, key, text))
    if not 0 <= number <= 65535:
        die("%s: setting `%s` must name a port between 0 and 65535, not %d"
            % (NAME, key, number))
    return host, number


def setting_dir(settings, key, default):
    """One setting as a non-empty **absolute** path, or a named fault.

    It is not required to exist: a run corpus is made by the daemon the first time a
    service fires, and a relay that refused to start on an empty home would be a worse
    answer than one that finds nothing to read.
    """
    value = setting_str(settings, key, default)
    if not os.path.isabs(value):
        die("%s: setting `%s` must be an absolute path, not %r" % (NAME, key, value))
    return value


# --- the run corpus ------------------------------------------------------------------
#
# The daemon serves its on-attach backfill burst only to a **TCP** client: a local-socket
# client is expected to share the filesystem and read the run dirs itself
# (`crates/app/src/host.rs`, the `if remote` around `served_backfill_lines`). A companion is
# handed the local socket, so nobody would read this corpus for the page — and a run view
# opened after a fire would be empty. This section is that read, performed here and served
# per subscriber as the very frames the daemon would have sent.
#
# It is a **mirror** of `crates/app/src/backfill.rs` plus `host::served_backfill_lines`,
# function for function, and each function names the Rust it was read off — the citation
# discipline `fold.mjs` already holds for `model.rs`, because the two can drift and the
# citation is the only thing that makes the drift findable.
#
# All I/O here is best-effort, the Rust's own posture: a missing service dir yields nothing,
# and a half-written or garbage trace records no fire and contributes nothing.

# The two per-run files, as `afkd_system::service` reserves their names.
TRACE_FILE = "trace.jsonl"
RUN_LOG_FILE = "run.log"

# The trailing bytes of a `run.log` the tail read spans, so a multi-MB transcript is never
# read whole. `TAIL_CAP_BYTES` (`crates/app/src/logfile.rs`).
TAIL_CAP_BYTES = 1 << 20

# How many trace nodes the window walk keeps before it stops. `TRACE_TREE_CAPACITY`
# (`crates/tui/src/tracetree.rs`) — the tree's **own** bound, not a second constant, so a
# backfilled client folds the runs a client that stayed connected still retains.
TRACE_TREE_CAPACITY = 2000

# The kinds that are a lifecycle **scope wrapper** rather than work. `is_fire_node`
# (`crates/app/src/backfill.rs`): a dir holding only these recorded no fire.
WRAPPER_KINDS = ("sandbox", "worktree")

# The node kinds and terminal statuses the wire spells, and what an unrecognised one
# degrades to — `tracefile::kind_from_str` / `status_from_str`, whose degradations exist
# because the engine's enums have no unknown variant. Mirrored rather than passed through so
# a browser and a terminal reading the same corpus render the same node.
NODE_KINDS = ("workflow", "agent", "cmd", "tool", "sandbox", "worktree", "guard",
              "parallel", "repeat", "sleep", "fs", "lifecycle")
NODE_STATUSES = ("ok", "failed", "skipped", "killed", "running")
UNKNOWN_KIND = "cmd"
UNKNOWN_STATUS = "failed"

# A zeroed civil stamp — the degradation for an `at` that does not parse, so the node still
# renders. `tracefile::ZERO_STAMP`.
ZERO_STAMP = {"year": 0, "month": 0, "day": 0, "hour": 0, "minute": 0, "second": 0,
              "millis": 0}


def name_segment(name):
    """A service name as its run-dir segment — `afkd_config::name_segment`.

    The wire name stays qualified (`ns::name`); only the lookup path is encoded, so this
    lands on the exact dir the daemon's `scratch_root` wrote.

    One known, accepted divergence from the Rust, which folds through `str::to_lowercase`:
    that mapping has a context-sensitive rule for a **final** Greek capital sigma (`ΟΔΟΣ` →
    `οδος`, with a final `ς`), and python's `str.lower()` has none (`οδοσ`). A service whose
    name ends in a capital sigma would therefore resolve to a different directory here. It
    is a comment rather than code: no config in this repo or its fixtures can produce one,
    and hand-rolling the rule would be a second spelling of a fold afkd itself does not
    special-case anywhere else.
    """
    return name.lower().replace("::", "__")


def runs_readable(base):
    """Whether `base` is a directory this process may list and read.

    Resolved **per burst**, never remembered: `<state dir>/runs` does not exist until a
    service first fires (the daemon makes it on the fire path), so a verdict latched at
    start would mean no backfill *ever* on a fresh install, even after the corpus appeared.
    The inverse — a runs dir removed after a good start — would otherwise report nothing
    while silently serving no history.
    """
    return os.path.isdir(base) and os.access(base, os.R_OK | os.X_OK)


def runs_fault(base, named):
    """The sentence `base` deserves, or `None` when its state is not a fault at all.

    Three cases, and the middle one is why this is a function rather than
    `not runs_readable(...)`:

    - **readable** -> `None`. There is nothing to say.
    - **missing, and nobody named it** -> `None` as well. The default base is
      `<state dir>/runs`, which the daemon makes the first time a service fires, so on a
      fresh install it is simply not there yet and will appear on its own. `afkd top` reads
      the same disk and says nothing at all about that state, and a page that flashed a
      refusal at every tab on every install until the first fire would be **louder than the
      terminal over the same disk** — which is the one thing this page is not allowed to be.
    - **missing while the block named a `runs_dir`, or there but unreadable** -> a sentence
      naming the path. Both are somebody's mistake rather than a state that fixes itself: a
      path written down that is not there, or one this process may not read.

    The one predicate both reports run through — the sentence written to stderr once at
    start, and the `meta.error` a subscriber's burst is replaced by — so the two can never
    disagree about what counts as a fault.
    """
    if runs_readable(base):
        return None
    if not named and not os.path.exists(base):
        return None
    return ("%s: no run corpus to read at %s, so a run view opens with no history"
            % (NAME, base))


def is_real_run_dir(path):
    """Whether `path` is a **real** run dir: a directory holding a `trace.jsonl`.

    `backfill.rs`'s `is_real_run_dir`. An abandoned force-fire dir (minted, `run.log` only,
    never a trace) is not, which is what keeps it from taking a slot in the window — and,
    because the log tail anchors on the newest of *that same* list, what keeps the log from
    anchoring an empty dir the tree skipped.
    """
    return os.path.isdir(path) and os.path.isfile(os.path.join(path, TRACE_FILE))


def recent_run_dirs(service_runs):
    """A service's real run sub-directories, oldest -> newest — `backfill.rs`'s.

    Keyed on mtime, tie-broken by name, and **not** on the run-name string: the run
    grammar's optional `-<ms>` conflict segment sits before the kind suffix, so within one
    second a conflict name sorts before the earlier natural one and lexical order is not
    chronological there. Best-effort: an unreadable dir or entry yields fewer dirs.
    """
    try:
        names = os.listdir(service_runs)
    except (OSError, ValueError):
        # `ValueError` is the embedded-NUL case, the same one the static route checks for by
        # hand: it is not an `OSError`, so without it a path carrying one would leave here as
        # a traceback on the daemon's log instead of as an empty window.
        return []
    dirs = []
    for name in names:
        path = os.path.join(service_runs, name)
        if not is_real_run_dir(path):
            continue
        try:
            mtime = os.stat(path).st_mtime_ns
        except OSError:
            mtime = 0
        dirs.append((mtime, name, path))
    dirs.sort()
    return [path for _, _, path in dirs]


def read_fire_run(path):
    """One run dir's trace read **once**, or `None` when it recorded no real fire.

    `backfill.rs`'s `read_fire_run`, returning the events already mapped to their wire
    shape: the window's bookkeeping then reads the very events it will emit, so the ids it
    stops on and the nodes it counts cannot be a second opinion about the same file.

    A fire is an `opened` whose kind is neither wrapper kind (`is_fire_node`): an empty
    `init`/`cleanup` under `in_sandbox` persists a run dir whose trace is a lone
    `sandbox` open/close, and that is not a fire.
    """
    if not is_real_run_dir(path):
        return None
    try:
        with open(os.path.join(path, TRACE_FILE), "r", encoding="utf-8",
                  errors="replace") as handle:
            body = handle.read()
    except (OSError, ValueError):
        return None
    events = []
    min_id = None
    max_id = 0
    nodes = 0
    fire = False
    for line in body.split("\n"):
        event = trace_line_to_wire(line)
        if event is None:
            continue
        events.append(event)
        if event["op"] != "opened":
            continue
        node = event["node"]
        min_id = node["id"] if min_id is None else min(min_id, node["id"])
        max_id = max(max_id, node["id"])
        nodes += 1
        fire = fire or node["kind"] not in WRAPPER_KINDS
    if not fire:
        return None
    return {"events": events, "min_id": min_id, "max_id": max_id, "nodes": nodes}


def tree_backfill_window(service_runs):
    """A service's run-tree window as `(dirs, events)` — `backfill.rs`'s
    `tree_backfill_window`, whose three walk rules this mirrors whole.

    Walking the trace-bearing dirs newest -> oldest:

    - a **fire-less** lifecycle dir takes no slot, does not end the walk and does not vote
      on the generation boundary, so right after a reload the window is still the previous
      generation's fires rather than blank;
    - the walk **stops before** a dir whose highest `opened` id is at or above the lowest of
      the oldest dir kept so far. Within one generation ids strictly increase in open order,
      so that regression can only be a re-minted allocator — an older daemon generation,
      whose nodes a connected client does not hold either;
    - the walk **stops after** the dir that brings the kept nodes to `TRACE_TREE_CAPACITY`.
      Crossing the bound on that last dir rather than stopping short is deliberate: folding
      a superset is harmless (the fold's own eviction drops whole oldest roots and lands on
      exactly the set a connected client retains), while stopping short would show *fewer*
      runs than one.

    The kept dirs are returned oldest -> newest, the order the fold rebuilds the live union
    in: the init lifecycle and each fire live in separate run dirs, and chronological
    folding lets a newer generation's first root clear the prior one through the fold's own
    generation guard — no disk-side generation bookkeeping.
    """
    kept = []
    oldest_min = None
    nodes = 0
    for path in reversed(recent_run_dirs(service_runs)):
        run = read_fire_run(path)
        if run is None:
            continue
        if oldest_min is not None and run["max_id"] >= oldest_min:
            break
        nodes += run["nodes"]
        # `min_id <= max_id < oldest_min`, so the floor only ever descends.
        oldest_min = run["min_id"]
        kept.append((path, run["events"]))
        if nodes >= TRACE_TREE_CAPACITY:
            break
    kept.reverse()
    dirs = [path for path, _ in kept]
    events = [event for _, run_events in kept for event in run_events]
    return dirs, events


def trace_line_to_wire(line):
    """One `trace.jsonl` line as the wire's `TraceEvent`, or `None` when it is malformed.

    The one place the two schemas meet, and the one piece here with no single Rust twin: the
    Rust goes disk -> engine -> wire across two files (`tracefile::trace_line_to_engine` and
    `host::trace_event_to_wire`), and they are genuinely different shapes — `ev` against
    `op`, a flat `id`/`parent`/`kind`/`label`/`detail` against a nested `node`, and an
    externally-tagged `out` object against an internally-tagged one.

    A `null` optional is **omitted** rather than crossed, which is what the daemon's own
    encoder does (`skip_serializing_if = "Option::is_none"`), so these frames are
    byte-comparable with the ones a TCP client is served.
    """
    try:
        event = json.loads(line)
    except ValueError:
        return None
    if not isinstance(event, dict):
        return None
    kind = event.get("ev")
    if kind == "opened":
        node_id = wire_u64(event.get("id"))
        if node_id is None:
            return None
        node = {
            "id": node_id,
            "kind": one_of(event.get("kind"), NODE_KINDS, UNKNOWN_KIND),
            "label": wire_text(event.get("label")),
            "detail": wire_text(event.get("detail")),
        }
        parent = wire_u64(event.get("parent"))
        if parent is not None:
            node["parent"] = parent
        return {"op": "opened", "node": node, "at": parse_at(event.get("at"))}
    if kind == "closed":
        node_id = wire_u64(event.get("id"))
        if node_id is None:
            return None
        closed = {
            "op": "closed",
            "id": node_id,
            "status": one_of(event.get("status"), NODE_STATUSES, UNKNOWN_STATUS),
            "elapsed_ms": wire_u64(event.get("elapsed_ms")) or 0,
        }
        out = out_to_wire(event.get("out"))
        if out is not None:
            closed["out"] = out
        cost = event.get("cost")
        if isinstance(cost, (int, float)) and not isinstance(cost, bool):
            closed["cost"] = cost
        for key in ("turns", "tokens"):
            value = wire_u64(event.get(key))
            if value is not None:
                closed[key] = value
        return closed
    if kind == "relabeled":
        node_id = wire_u64(event.get("id"))
        if node_id is None:
            return None
        return {"op": "relabeled", "id": node_id, "label": wire_text(event.get("label"))}
    # An unrecognised `ev` — a newer writer's event — is dropped, not faulted, which is the
    # Rust reader's own rule.
    return None


def out_to_wire(out):
    """A `closed` line's externally-tagged `out` as the wire's internally-tagged one.

    `{"lines":N}` -> `{"out":"lines","n":N}`, `{"bytes":N}` likewise, and
    `{"diff":{"added":N,"removed":N}}` -> `{"out":"diff","added":N,"removed":N}`. A `null`
    (the common case: most nodes measure no output) or anything unrecognised yields `None`,
    which the caller omits from the frame.
    """
    if not isinstance(out, dict) or len(out) != 1:
        return None
    for key in ("lines", "bytes"):
        n = wire_u64(out.get(key))
        if n is not None:
            return {"out": key, "n": n}
    diff = out.get("diff")
    if isinstance(diff, dict):
        added = wire_u64(diff.get("added"))
        removed = wire_u64(diff.get("removed"))
        if added is not None and removed is not None:
            return {"out": "diff", "added": added, "removed": removed}
    return None


def wire_u64(value):
    """`value` as a non-negative integer, or `None` — JSON's `true` is not a 1 here."""
    if isinstance(value, bool) or not isinstance(value, int) or value < 0:
        return None
    return value


def wire_text(value):
    """`value` as a string, or the empty string — the wire's `#[serde(default)]`."""
    return value if isinstance(value, str) else ""


def one_of(value, vocabulary, fallback):
    """`value` if the wire spells it, else `fallback` — the two skew degradations."""
    return value if value in vocabulary else fallback


def parse_at(text):
    """The 19-byte `yymmdd hh:mm:ss.sss` civil stamp as the wire's `TraceStamp` object.

    `tracefile::parse_at`: the fields are sliced by their fixed offsets — the exact layout
    `StampTime::format` writes — and any fault at all degrades to `ZERO_STAMP` rather than
    dropping the node. The digit check is explicit because the Rust parses into integers
    that reject a sign, a space and a non-ASCII digit, and python's `int()` accepts all
    three.
    """
    if not isinstance(text, str) or len(text) != 19:
        return dict(ZERO_STAMP)
    fields = (("year", 0, 2), ("month", 2, 4), ("day", 4, 6), ("hour", 7, 9),
              ("minute", 10, 12), ("second", 13, 15), ("millis", 16, 19))
    stamp = {}
    for key, start, end in fields:
        part = text[start:end]
        if not (part.isascii() and part.isdigit()):
            return dict(ZERO_STAMP)
        stamp[key] = int(part)
    stamp["year"] += 2000
    return stamp


def tail_run_log(path, max_lines):
    """The last `max_lines` physical lines of a `run.log`, each as `(stamp, text)`.

    `logfile::tail_run_log`. The read is byte-bounded to `TAIL_CAP_BYTES`: when the window
    does not reach the file start its first (likely half-cut) line is dropped, so no partial
    line is ever emitted; a killed run's final unterminated line is kept. A missing / empty
    / unreadable file yields nothing.

    The split mirrors Rust's `str::lines` exactly — on `\\n`, dropping the trailing empty
    after a terminating newline and stripping one `\\r` before it — rather than
    `str.splitlines()`, which would also break on the vertical tab, the form feed and
    `U+2028` and so cut a line the daemon wrote whole.
    """
    try:
        with open(path, "rb") as handle:
            handle.seek(0, os.SEEK_END)
            length = handle.tell()
            if length == 0:
                return []
            start = max(0, length - TAIL_CAP_BYTES)
            handle.seek(start)
            blob = handle.read()
    except (OSError, ValueError):
        return []
    lines = blob.decode("utf-8", "replace").split("\n")
    if lines and lines[-1] == "":
        lines.pop()
    lines = [line[:-1] if line.endswith("\r") else line for line in lines]
    if start > 0 and lines:
        lines.pop(0)
    return [split_stamp(line) for line in lines[max(0, len(lines) - max_lines):]]


def split_stamp(line):
    """One `run.log` line split into its `(stamp, text)` — `logfile::split_stamp`.

    The stamp is the fixed 19-character prefix `StampingSink::stamp_one` writes, followed by
    one space. A prefix that does not parse to a real stamp — a pre-stamp line, or a corrupt
    head — degrades to `ZERO_STAMP` and keeps the **whole** line as its text.
    """
    if len(line) > 19 and line[19] == " ":
        stamp = parse_at(line[:19])
        if stamp != ZERO_STAMP:
            return stamp, line[20:]
    return dict(ZERO_STAMP), line


def sanitize_log_line(text):
    """One logical log line as printable, single-line text — `sanitize_log_line`
    (`crates/engine/src/logtext.rs`), and `fold.mjs`'s `sanitize()` byte for byte.

    A log line is a child's own output, so its bytes must never be a write primitive on the
    reader's screen: an `ESC [` opens a CSI and is dropped through its final byte in
    `@`..=`~` (an unterminated one to end of line); any other `ESC` drops just the escape,
    leaving its payload as inert printable residue; a tab becomes one space; every other C0
    control and DEL is dropped, which is where an embedded `\\r` is neutralised in place;
    and the Unicode format characters (`General_Category=Cf` — the bidi overrides, the
    zero-width set, the BOM) go, since a line carrying them can display as text that reads
    differently from what it is.

    This runs on **this** side of the wire, as the daemon's own served tail does, because
    `Frame::BackfillLog` carries the already-sanitized ring text. The page's ring is keyed on
    that text at the backfill/live seam, so the two spellings have to be one — which
    `backfill.test.mjs` asserts over the recorded adversarial line set rather than trusting
    this paragraph.
    """
    chars = list(text)
    out = []
    i = 0
    while i < len(chars):
        char = chars[i]
        i += 1
        if char == "\x1b":
            if i < len(chars) and chars[i] == "[":
                i += 1
                while i < len(chars):
                    code = ord(chars[i])
                    i += 1
                    if 0x40 <= code <= 0x7e:
                        break
            continue
        if char == "\t":
            out.append(" ")
            continue
        code = ord(char)
        if code < 0x20 or code == 0x7f or unicodedata.category(char) == "Cf":
            continue
        out.append(char)
    return "".join(out)


def backfill_frames(base, targets, log_lines):
    """The whole burst one subscriber is served, in order — the wire twin of
    `host::served_backfill_lines`.

    Per service, its run-tree window replayed as `backfill` frames, then the `run.log` tail
    of that window's **newest** dir as `backfill_log` frames. The log anchors on
    `dirs[-1]` — the exact dir the tree burst ended on, not a second picker — which is what
    makes the two structurally unable to disagree about which dir is real.

    The tail is bounded by `log_lines`, the ring bound this subscriber was told on its
    `stream` event: serving more would be serving lines the page drops on arrival.

    The single producer both callers use — the stream seam and `--backfill` — so the
    inspection mode cannot drift from what a subscriber is actually served.
    """
    frames = []
    for name, busy in targets:
        dirs, events = tree_backfill_window(os.path.join(base, name_segment(name)))
        for event in events:
            frames.append({"type": "backfill", "service": name, "event": event})
        if not dirs:
            continue
        tail = tail_run_log(os.path.join(dirs[-1], RUN_LOG_FILE), log_lines)
        for i, (stamp, text) in enumerate(tail):
            frames.append({
                "type": "backfill_log",
                "service": name,
                "stamp": stamp,
                # Sanitized here, as the daemon sanitizes its own served tail: the wire's
                # `BackfillLog.line` is the already-clean ring text, unlike live `Log`.
                "line": sanitize_log_line(text),
                "busy": busy,
                "last": i == len(tail) - 1,
            })
    return frames


def snapshot_targets(snapshot):
    """The `(service, busy)` pairs a burst reads run dirs for, off the attach snapshot.

    The very list the snapshot seeded, which is where the daemon takes its own targets from
    (`host.rs`, `backfill_targets`) — so the burst can never name a service the board has
    not seen, and a frame naming one would be dropped by the page's fold anyway.
    """
    services = snapshot.get("services")
    if not isinstance(services, list):
        return []
    targets = []
    for entry in services:
        if not isinstance(entry, dict):
            continue
        name = entry.get("name")
        if not isinstance(name, str) or not name:
            continue
        busy_ms = entry.get("busy_ms")
        busy = not isinstance(busy_ms, bool) and isinstance(busy_ms, int) and busy_ms != 0
        targets.append((name, busy))
    return targets


def as_snapshot(line):
    """The attach snapshot `line` carries, or `None` — the one frame this relay parses.

    Best-effort by design: a line that is not JSON, or not an object, or not this frame, is
    simply not the snapshot. It has already been forwarded verbatim by the time this is
    asked, so nothing here can cost a subscriber a frame.
    """
    try:
        frame = json.loads(line.decode("utf-8", "replace"))
    except ValueError:
        return None
    if not isinstance(frame, dict):
        return None
    if frame.get("type") != "meta" or frame.get("meta") != "snapshot":
        return None
    return frame


# --- the attaches ------------------------------------------------------------------


class Overflow(Exception):
    """A wire line past `MAX_LINE`, which a conforming daemon cannot produce."""


class Attach:
    """One subscriber's own connection to the daemon.

    The reader is the stream's own handler thread and the writer is whichever
    `POST /command` thread names this attach's id, so `send_lock` is what keeps two tabs
    from interleaving half a frame. `buf` is the partial line a keepalive must not lose.
    """

    def __init__(self, sock):
        self.sock = sock
        # The handle a `POST /command` names to reach **this** attach. Unguessable, so one
        # browser cannot drive another's stream by counting.
        self.id = os.urandom(8).hex()
        self.send_lock = threading.Lock()
        self.buf = bytearray()

    def send(self, frame):
        blob = (json.dumps(frame) + "\n").encode("utf-8")
        with self.send_lock:
            self.sock.sendall(blob)

    def readline(self):
        """One wire line without its newline, or `None` at end of stream.

        Hand-rolled rather than `sock.makefile()`, because the keepalive is a socket
        timeout on a **partially read** line: the caller writes its comment and calls this
        again, and `buf` is what makes that lossless. An over-cap line raises rather than
        being buffered whole — the bound both ends hold.
        """
        while True:
            end = self.buf.find(b"\n")
            # The cap is judged on the **line**, not on what one `recv` happened to
            # deliver: a read that brings the terminator and 80 KiB of body in the same
            # chunk must still refuse it.
            if end > MAX_LINE or (end < 0 and len(self.buf) > MAX_LINE):
                raise Overflow(
                    "the daemon sent a line past the %d-byte cap the wire fixes" % MAX_LINE
                )
            if end >= 0:
                line = bytes(self.buf[:end])
                del self.buf[: end + 1]
                return line
            chunk = self.sock.recv(65536)
            if not chunk:
                return None
            self.buf.extend(chunk)

    def shutdown(self):
        """End the blocking read this attach's stream thread is sitting in."""
        try:
            self.sock.shutdown(socket.SHUT_RDWR)
        except OSError:
            # Already gone — the daemon closed it, or the stream thread got there first.
            pass

    def close(self):
        self.shutdown()
        try:
            self.sock.close()
        except OSError:
            pass


class Attaches:
    """Every live attach, behind one lock, with the `max_clients` ceiling inside it.

    The ceiling is checked **under** the lock on purpose: two `GET /stream`s arriving
    together must not both take the last slot.
    """

    def __init__(self, max_clients):
        self.cond = threading.Condition()
        self.max_clients = max_clients
        self.live = {}

    def open(self, sock):
        """Register a connected socket as an attach, or `None` if the ceiling is full."""
        attach = Attach(sock)
        with self.cond:
            if len(self.live) >= self.max_clients:
                return None
            self.live[attach.id] = attach
            return attach

    def close(self, attach):
        with self.cond:
            self.live.pop(attach.id, None)
            self.cond.notify_all()
        attach.close()

    def get(self, stream_id):
        # Only a string is ever a key here, and a body is whatever a client posted: a
        # lookup on an unhashable value would be a traceback rather than a 404.
        if not isinstance(stream_id, str):
            return None
        with self.cond:
            return self.live.get(stream_id)

    def shutdown_all(self):
        """Wake every stream thread by ending its read, leaving each to retire itself.

        The registry is deliberately **not** cleared here: its emptying is what
        [`drained`] waits on, so a stream that has taken its final event is the thing that
        counts, not a socket that was closed under one.
        """
        with self.cond:
            attaches = list(self.live.values())
        for attach in attaches:
            attach.shutdown()

    def drained(self, timeout):
        with self.cond:
            return self.cond.wait_for(lambda: not self.live, timeout=timeout)


class Relay:
    """What the handler threads share: where the daemon is, who is attached, and the latch.

    There is nothing else — no folded board, no cached frame. The **page** folds, in
    `fold.mjs`; this process forwards.

    `runs_dir` is the daemon's run corpus, read fresh on every subscriber's snapshot (the
    burst in [`Handler.backfill`]) and cached in neither this object nor any other: a base
    that appears after the daemon's first fire is served, and one that vanishes is reported.
    `log_lines` is only carried — it is handed to the page on its `stream` event, because
    the ring it bounds lives in the browser, and it is the bound the served tail is cut to.
    """

    def __init__(self, socket_path, runs_dir, runs_named, max_clients, log_lines):
        self.socket_path = socket_path
        self.runs_dir = runs_dir
        # Whether the block **named** `runs_dir` rather than taking the default — which is
        # what [`runs_fault`] reads to tell a configuration mistake from a fresh install.
        self.runs_named = runs_named
        self.log_lines = log_lines
        self.attaches = Attaches(max_clients)
        self.stopping = threading.Event()

    def dial(self):
        """A fresh connection to the daemon, with the keepalive as its read timeout."""
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        sock.settimeout(KEEPALIVE_S)
        sock.connect(self.socket_path)
        return sock


# --- the listener ------------------------------------------------------------------


class Handler(http.server.BaseHTTPRequestHandler):
    """Three routes: the static files beside this program, `GET /stream`, `POST /command`.

    `relay` is set on the server.
    """

    protocol_version = "HTTP/1.1"

    def log_message(self, fmt, *args):
        # Deliberately silent. After the handshake both streams are pumped into the daemon
        # log under this plugin's tag, and a page a browser polls would write a line there
        # every couple of seconds forever. Faults still speak: `log_error` is the one
        # BaseHTTPRequestHandler calls for a request it could not serve.
        pass

    def log_error(self, fmt, *args):
        sys.stderr.write("%s: %s\n" % (NAME, fmt % args))
        sys.stderr.flush()

    # -- routes --

    def do_GET(self):
        route = self.route()
        if route == "/stream":
            self.stream()
        else:
            self.static(route)

    def do_POST(self):
        if self.route() != "/command":
            self.fault(404, "no route %s; commands go to POST /command" % self.path)
            return
        body = self.body()
        if body is None:
            return
        attach = self.server.relay.attaches.get(body.get("stream"))
        if attach is None:
            # The stream is how a command reaches **this** client's own attach, so an id
            # that names none is a 404 rather than a frame on somebody else's socket.
            self.fault(404, "no open stream %r; open GET /stream and post the id it deals "
                            "you" % (body.get("stream"),))
            return
        frame = self.frame(body)
        if frame is None:
            return
        try:
            attach.send(frame)
        except OSError as err:
            self.fault(502, "the daemon would not take the command: %s" % err)
            return
        # The daemon's answer arrives on this client's own stream, which is the whole point
        # of keying by stream id.
        self.respond(200, "application/json", b'{"ok":true}')

    def route(self):
        """The request path, without its query and percent-decoded.

        Decoding **before** the checks is load-bearing: `%2e%2e%2f` is a traversal the
        allowlist below would otherwise read as one innocent segment.
        """
        return urllib.parse.unquote(self.path.split("?", 1)[0])

    # -- the static files --

    def static(self, route):
        """One file from this program's own directory, by an allowlisted extension.

        A single path segment, so there is no directory to walk out of: a nested path, a
        `..`, the manifest, the README and this program itself are each a 404.

        The NUL check sits with the other name checks rather than with the read below on
        purpose: an embedded null raises `ValueError`, not the `OSError` the read catches,
        so `/%00.html` would leave here as a traceback on stderr — which is the daemon's
        log — instead of as this route's one refusing sentence.
        """
        name = "index.html" if route == "/" else route[1:]
        extension = os.path.splitext(name)[1]
        if ("/" in name or "\0" in name or name.startswith(".")
                or extension not in STATIC_TYPES):
            self.fault(404, "no route %s; this relay serves %s, GET /stream and "
                            "POST /command" % (route, ", ".join(sorted(STATIC_TYPES))))
            return
        try:
            with open(os.path.join(HERE, name), "rb") as handle:
                body = handle.read()
        except OSError:
            self.fault(404, "no file %s beside this relay" % name)
            return
        self.respond(200, STATIC_TYPES[extension], body)

    # -- the stream --

    def stream(self):
        """One subscriber: its own attach, its own handshake, its own snapshot.

        The connection is dialled **before** the headers go out, so a daemon that will not
        take another client is a 503 with a sentence rather than a half-open event stream
        the browser has to time out on.
        """
        relay = self.server.relay
        try:
            sock = relay.dial()
        except OSError as err:
            self.fault(503, "cannot attach to the control socket afkd named: %s" % err)
            return
        attach = relay.attaches.open(sock)
        if attach is None:
            sock.close()
            self.fault(503, "this relay is already serving %d subscribers; close a tab or "
                            "raise `max_clients`" % relay.attaches.max_clients)
            return
        try:
            self.send_response(200)
            self.send_header("Content-Type", "text/event-stream")
            self.send_header("Cache-Control", "no-store")
            self.send_header("Connection", "close")
            self.end_headers()
            self.close_connection = True
            # The id first, so a page can post a command the moment it has one — before
            # the welcome, which is the slower half. `log_lines` rides along because the
            # page's fold needs it before the first frame arrives.
            hello = {"id": attach.id, "log_lines": relay.log_lines}
            self.event("stream", json.dumps(hello).encode("utf-8"))
            if self.handshake(attach):
                self.forward(attach)
        except OSError:
            # A browser tab that went away — a broken pipe or a reset connection, both
            # `OSError`. There is nothing to report: the subscriber is simply gone.
            return
        finally:
            relay.attaches.close(attach)

    def handshake(self, attach):
        """Phase 1 on this subscriber's own attach; whether phase 2 follows.

        The daemon's reply crosses **verbatim** as its own event rather than as a `data:`
        line, which is what keeps "every `data:` line is a phase-2 frame" exactly true.
        """
        attach.send({"afkd": "hello", "proto": WIRE_PROTO})
        line = self.read(attach)
        if line is None:
            return False
        try:
            reply = json.loads(line.decode("utf-8", "replace"))
            tag = reply.get("afkd") if isinstance(reply, dict) else None
        except ValueError:
            tag = None
        if tag == "welcome":
            self.event("welcome", line)
            return True
        if tag == "reject":
            self.event("refused", line)
            return False
        self.event("error", json.dumps(
            {"message": "the daemon answered the handshake with neither a welcome nor a "
                        "refusal"}).encode("utf-8"))
        return False

    def forward(self, attach):
        """Every frame the daemon writes, verbatim, one `data:` line each — plus this
        subscriber's own backfill burst, injected once on the attach snapshot.

        The burst goes **after** the snapshot and before anything the daemon says next,
        which is both the daemon's own order for its TCP burst and the only order the page's
        fold accepts: a frame naming a service the board has not seen is dropped, so nothing
        may precede the snapshot that seeds it.

        Until the snapshot has been seen each forwarded line is also parsed, best-effort;
        after it the loop is byte-verbatim forever. The read is synchronous on this
        subscriber's own thread, which is the point: frames the daemon writes meanwhile
        queue in its send buffer and are forwarded *after* the burst, reproducing the
        `[attach, read]` overlap window the daemon's own path has — and whose duplicates the
        fold is built to absorb, by `openNode`'s identical-replay dedup and by the ring's
        content-keyed seam.
        """
        seeded = False
        while True:
            line = self.read(attach)
            if line is None:
                return
            self.write(b"data: " + line + b"\n\n")
            if not seeded:
                snapshot = as_snapshot(line)
                if snapshot is not None:
                    seeded = True
                    self.backfill(snapshot)

    def backfill(self, snapshot):
        """This subscriber's run history, off disk, as `backfill` / `backfill_log` frames.

        The runs base is stat'd **now** rather than at start (see [`runs_readable`]), and a
        base that is missing or unreadable serves no backfill at all: one composed
        `meta.error` goes out instead, which the page flashes exactly as it flashes the
        daemon's own (`session.mjs`'s `noteFrame`). The sentence opens with this plugin's
        name, since to the page it is indistinguishable from a refusal the daemon sent.

        It never fails the stream over it, and it never guesses a second path.
        """
        relay = self.server.relay
        if not runs_readable(relay.runs_dir):
            fault = runs_fault(relay.runs_dir, relay.runs_named)
            if fault is not None:
                self.wire({"type": "meta", "meta": "error", "message": fault})
            return
        for frame in backfill_frames(relay.runs_dir, snapshot_targets(snapshot),
                                     relay.log_lines):
            self.wire(frame)

    def wire(self, frame):
        """One frame this relay **composed**, written as a subscriber-facing `data:` line.

        The same shape [`forward`] writes for a frame the daemon sent, because to the page
        there is no difference: a `data:` line is a wire frame, whichever side read it.
        """
        self.write(b"data: " + json.dumps(frame).encode("utf-8") + b"\n\n")

    def read(self, attach):
        """The next wire line, or `None` once this stream is over.

        Every way it can end writes the browser its own event first — a stopping daemon, a
        closed socket and an over-cap line are three different sentences, and a page that
        reopens wants to know which one it got.
        """
        relay = self.server.relay
        while True:
            if relay.stopping.is_set():
                self.event("bye", b"{}")
                return None
            try:
                line = attach.readline()
            except socket.timeout:
                # Quiet is not death: the comment goes out and the same partial line is
                # read on.
                self.write(b": keepalive\n\n")
                continue
            except Overflow as err:
                # Nothing on stderr: a conforming daemon cannot produce this, and the
                # browser is the party that needs telling.
                self.event("error", json.dumps({"message": str(err)}).encode("utf-8"))
                return None
            except OSError:
                line = None
            if line is None:
                if relay.stopping.is_set():
                    self.event("bye", b"{}")
                else:
                    self.event("closed", json.dumps(
                        {"reason": "daemon"}).encode("utf-8"))
                return None
            return line

    # -- the command body --

    def body(self):
        """The `POST /command` body as an object, or `None` once the fault is written."""
        try:
            length = int(self.headers.get("Content-Length") or 0)
        except ValueError:
            self.fault(400, "Content-Length is not a number")
            return None
        if length > MAX_LINE:
            self.fault(400, "a command body is capped at %d bytes" % MAX_LINE)
            return None
        try:
            body = json.loads(self.rfile.read(length).decode("utf-8", "replace"))
        except ValueError:
            self.fault(400, "the command body is not JSON")
            return None
        if not isinstance(body, dict):
            self.fault(400, "the command body is not an object")
            return None
        return body

    def frame(self, body):
        """The `command` frame `body` asks for, or `None` once the fault is written.

        The frame is **composed** here rather than forwarded, so a client cannot smuggle a
        field of its own onto the wire, and a verb this relay does not know reaches the
        socket as nothing at all.
        """
        verb = body.get("command")
        service = body.get("service")
        if verb in SERVICE_VERBS:
            if not isinstance(service, str) or not service:
                self.fault(400, "`%s` needs a service" % verb)
                return None
            return {"type": "command", "command": verb, "service": service}
        if verb in GLOBAL_VERBS:
            return {"type": "command", "command": verb}
        if verb in OPTIONAL_SERVICE_VERBS:
            if service is None:
                return {"type": "command", "command": verb}
            if not isinstance(service, str) or not service:
                self.fault(400, "`%s` takes one service or none, not %r" % (verb, service))
                return None
            return {"type": "command", "command": verb, "service": service}
        self.fault(400, "the control wire has no command %r; it has %s"
                   % (verb, ", ".join(VOCABULARY)))
        return None

    # -- replies --

    def event(self, name, payload):
        self.write(b"event: " + name.encode("utf-8") + b"\ndata: " + payload + b"\n\n")

    def write(self, blob):
        self.wfile.write(blob)
        self.wfile.flush()

    def respond(self, status, content_type, body):
        self.send_response(status)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def fault(self, status, sentence):
        self.respond(status, "text/plain; charset=utf-8", (sentence + "\n").encode("utf-8"))


class Server(http.server.ThreadingHTTPServer):
    daemon_threads = True
    # A browser tab that vanishes leaves a half-open connection; the listener must come
    # straight back on a restart rather than sitting in TIME_WAIT.
    allow_reuse_address = True


# --- the two ends ------------------------------------------------------------------


def watch_stdin(httpd, relay, ready):
    """EOF on stdin is the daemon saying stop.

    afkd says nothing more on that pipe after the `hello`, so the next thing to arrive is
    the close. The latch goes up, every attach's read is ended so its stream wakes and
    takes a final `bye`, and the listener goes — all well inside the daemon's five-second
    grace, because a `systemctl stop` must not look like a crash.
    """
    sys.stdin.readline()
    relay.stopping.set()
    relay.attaches.shutdown_all()
    # Bounded, and a poll rather than a join: a browser that stopped reading must not hold
    # the drain.
    relay.attaches.drained(STREAM_DRAIN_S)
    # `shutdown()` is only meaningful once `serve_forever` owns the socket.
    ready.wait()
    httpd.shutdown()


def hello():
    """Phase 0: the one line afkd sends, checked, or a named fault.

    The read itself is the 60 s deadline — afkd is the only writer on this pipe and it
    writes immediately — and the line is capped the way every other frame is.
    """
    line = sys.stdin.readline(MAX_LINE + 1)
    if not line:
        die("%s: afkd closed stdin before sending its `hello`" % NAME)
    if len(line) > MAX_LINE:
        die("%s: afkd's `hello` line is past the %d-byte cap the wire fixes"
            % (NAME, MAX_LINE))
    try:
        call = json.loads(line)
    except ValueError:
        die("%s: afkd's `hello` line is not JSON: %s" % (NAME, line.strip()))
    if not isinstance(call, dict) or call.get("call") != "hello":
        die("%s: expected a `hello` call from afkd, got %s" % (NAME, line.strip()))
    if call.get("proto") != PLUGIN_PROTO:
        die("%s: plugin protocol skew: this plugin speaks v%s, afkd speaks v%s"
            % (NAME, PLUGIN_PROTO, call.get("proto")))
    return call


def named_socket(call):
    """The socket path out of the `hello`, as a path.

    It never resolves the path itself: a companion under a relocated afkd home must reach
    the daemon that started it, and the only way to be sure is to be told.
    """
    path = call.get("socket")
    if not isinstance(path, str) or not path:
        die("%s: afkd's `hello` named no control socket" % NAME)
    return path


def check_socket(path):
    """That the path afkd named really is a socket, before anything is served.

    Checked rather than dialled: a probe connection would show up in the daemon's own
    client log every time this companion starts. Deliberately **after** the settings, so a
    malformed `listen` is named as the malformed `listen` rather than masked by whatever the
    home looks like.
    """
    try:
        if not stat.S_ISSOCK(os.stat(path).st_mode):
            die("%s: the path afkd named is not a socket: %s" % (NAME, path))
    except OSError as err:
        die("%s: cannot reach the control socket afkd named: %s" % (NAME, err))


def inspect(runs_dir, service, liveness):
    """`--backfill <runs_dir> <service> busy|idle`: the burst that service would be served.

    One JSON frame per line, on stdout — the operator-facing answer to "what history does a
    tab opening now actually get?". It runs `backfill_frames` itself, the same producer the
    stream seam calls, so the dump cannot drift from what a subscriber is served; and it is
    what `backfill.test.mjs` replays, so the read is tested exactly as it ships rather than
    re-stated in javascript.

    Reads no stdin and binds no port. The ring bound is the default: this mode has no
    subscriber to have been told another.
    """
    if liveness not in ("busy", "idle"):
        die("%s: --backfill takes `busy` or `idle`, not %r" % (NAME, liveness))
    if not runs_readable(runs_dir):
        die("%s: no run corpus to read at %s" % (NAME, runs_dir))
    for frame in backfill_frames(runs_dir, [(service, liveness == "busy")],
                                 DEFAULT_LOG_LINES):
        sys.stdout.write(json.dumps(frame) + "\n")
    sys.stdout.flush()
    return 0


def main():
    # The one argument form this program takes. Guarded to exactly the three-argument shape,
    # so the daemon's own invocation — no arguments at all, a `hello` on stdin — cannot fall
    # into it.
    if sys.argv[1:2] == ["--backfill"]:
        if len(sys.argv) != 5:
            die("%s: usage: web-top --backfill <runs_dir> <service> busy|idle" % NAME)
        return inspect(sys.argv[2], sys.argv[3], sys.argv[4])
    call = hello()
    socket_path = named_socket(call)
    settings = call.get("settings")
    if not isinstance(settings, dict):
        settings = {}
    bind, port = setting_listen(settings, "listen", DEFAULT_HOST, DEFAULT_PORT)
    max_clients = setting_int(settings, "max_clients", DEFAULT_MAX_CLIENTS, 1, 64)
    runs_dir = setting_dir(
        settings, "runs_dir", os.path.join(os.path.dirname(socket_path), "runs")
    )
    log_lines = setting_int(settings, "log_lines", DEFAULT_LOG_LINES, 1, 100000)
    check_socket(socket_path)
    # One sentence, once, naming a runs base that is a genuine fault — the daemon log carries
    # it under `companion @afkd/web-top: err`. A **report**, not a latch: it decides nothing
    # about what any later burst does, and never a `die()`, because the relay comes up either
    # way and every subscriber is told on its own stream besides.
    fault = runs_fault(runs_dir, "runs_dir" in settings)
    if fault is not None:
        print(fault, file=sys.stderr, flush=True)

    sys.stdout.write(json.dumps({"ok": True, "proto": PLUGIN_PROTO}) + "\n")
    sys.stdout.flush()

    relay = Relay(socket_path, runs_dir, "runs_dir" in settings, max_clients, log_lines)
    try:
        httpd = Server((bind, port), Handler)
    except OSError as err:
        die("%s: cannot serve on %s:%d: %s" % (NAME, bind, port, err))
    httpd.relay = relay

    ready = threading.Event()
    threading.Thread(target=watch_stdin, args=(httpd, relay, ready), daemon=True).start()

    # The line an operator reads out of the daemon log, and the only place an ephemeral
    # `:0` announces what it got.
    print("serving http://%s:%d" % (bind, httpd.server_address[1]), flush=True)
    ready.set()
    httpd.serve_forever(poll_interval=0.1)
    httpd.server_close()
    return 0


if __name__ == "__main__":
    sys.exit(main())
